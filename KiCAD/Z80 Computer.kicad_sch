	(text "ROM and RAM.  A 27C64 or larger would \nalso work.  If using a larger ROM,\nduplicate the program across all\nbanks.  It would also be possible to use\na larger RAM such as 62256.  If you actually\nwant to use the additional RAM, I believe a\nfew traces to the 74HCT138 would need to be cut\nand jumper wires installed."
		(exclude_from_sim no)
		(at 322.072 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0078080e-7875-4df5-88a6-a53634de21e6")
	)
	(text "Decoupling capacitors"
		(exclude_from_sim no)
		(at 68.834 364.998 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2a36b74a-26ca-4de2-8913-10390b63917c")
	)
	(text "Mounting holes"
		(exclude_from_sim no)
		(at 343.916 34.544 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2e68ccd9-ce80-446e-83ea-f81685904f4c")
	)
	(text "7 segment driver, isolated resistor\nnetworks, and 7 segment displays\n(common cathode, negative)."
		(exclude_from_sim no)
		(at 414.528 269.494 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2f0aa41b-ae1c-4a9a-bb8f-7d43ee4d6a60")
	)
	(text "Buttons and input switches.  Pulldown\nresistors are used as 74HCT don't like\nfloating inputs."
		(exclude_from_sim no)
		(at 235.966 348.234 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "39bb1fcf-b2bc-468f-96ae-db2ab5ec8e07")
	)
	(text "Expansion header, same pinout as Z80"
		(exclude_from_sim no)
		(at 89.408 261.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "47b57d46-ae81-4bbd-8608-069c42eb02df")
	)
	(text "IO Decoding Logic\n\n7SEG_1: 0X00\n7SEG_2: 0X01\n7SEG_3: 0X02\n7SEG_4: 0X03\nButtons: 0X04\nSwitch 1: 0X05\nSwitch 1: 0X06\n"
		(exclude_from_sim no)
		(at 233.426 267.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "629d4001-ad75-43a9-bacd-52b2b5756b59")
	)
	(text "Z80 CPU and pull up resistors.\nCMOS required to use 555 timer,\notherwise NMOS should work fine."
		(exclude_from_sim no)
		(at 181.102 136.906 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7061c26a-f040-40ba-8d21-9f5468952b0f")
	)
	(text "ROM and RAM address decoding logic\n\nROM: 0X0000 - 0X1FFF\nRAM: 0X2000 - 0X3FFF\n\n0X4000 - 0XFFFF is free, so \nadditional RAM or ROM could\nbe added using the expansion\nheader.  Execution starts at 0X0000."
		(exclude_from_sim no)
		(at 179.578 268.732 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "71e2ad30-79bf-487b-8222-4c4c5c038cfa")
	)
	(text "Power jack, 5v center positive"
		(exclude_from_sim no)
		(at 231.394 34.036 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9959b03a-da14-4334-b9d2-f9d24fbf5076")
	)
	(text "Drivers for address lines\nand data lines LEDs.  Optional,\nbut the blikenlights are fun :)."
